{
  "manifest_version": 2,
  "version": "2.0.4",
  "name": "群聊逻辑优化",
  "description": "通过 Hook 集中提供访问控制（白名单/黑名单/全量）、Embedding+对话状态指向判断与纯规则降级、低延迟调度、回复目标去重、技术话题防幻觉、输出卫生、多模态桥接、表情包冷却。",
  "author": {
    "name": "Luoyehe",
    "url": "https://github.com/Luoyehe"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Luoyehe/Maibot-group-chat-logic-optimizer",
    "homepage": "https://github.com/Luoyehe/Maibot-group-chat-logic-optimizer#readme",
    "issues": "https://github.com/Luoyehe/Maibot-group-chat-logic-optimizer/issues"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.2.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "management",
  "capabilities": [
    "config.get",
    "llm.get_available_models",
    "llm.embed"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.luoyehe.group-chat-logic-optimizer"
}
